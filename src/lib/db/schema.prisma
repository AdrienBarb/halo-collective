
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  firstName     String?
  lastName      String?
  countryCode   String?
  phone         String?
  role          UserRole  @default(USER)
  locale        String    @default("fr")
  trackingParams Json?    @map("tracking_params")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  interestSports       String[] @default([])    @map("interest_sports")
  interestLifestyle    String[] @default([])    @map("interest_lifestyle")
  interestBrands       String[] @default([])    @map("interest_brands")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions NewsletterSubscription[]
  engagementResponses FanEngagementResponse[]

  @@unique([email])
  @@map("user")
}

enum Sport {
  TENNIS
}

enum UserRole {
  USER
  ADMIN
}

enum NewsletterStatus {
  DRAFT
  SENDING
  PUBLISHED
}

enum SectionType {
  ATHLETE_REVIEW
  WEEK_RECAP
  COMING_UP
  MONETISATION
  FAN_ENGAGEMENT
}

enum EditionMode {
  TOURNAMENT
  WEEKLY
}

model Athlete {
  id           String   @id @default(cuid())
  slug         String   @unique
  firstName    String
  lastName     String
  sport        Sport    @default(TENNIS)
  tour         String?
  countryCode  String
  countryName  String
  bio          String?
  avatarUrl    String?
  coverImageUrl String?
  worldRank    Int?
  countryRank  Int?
  titlesCount  Int      @default(0)
  socialLinks  Json?
  welcomeMessage String?  @db.VarChar(4000)
  brevoListId  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  newsletters   Newsletter[]
  subscriptions NewsletterSubscription[]
  sponsors      Sponsor[]

  @@map("athlete")
}

model Sponsor {
  id         String   @id @default(cuid())
  athleteId  String
  name       String
  logoUrl    String
  websiteUrl String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@map("sponsor")
}

model Newsletter {
  id                  String           @id @default(cuid())
  athleteId           String
  editionNumber       Int
  editionDate         DateTime?
  editionMode         EditionMode      @default(WEEKLY)
  title               String
  emailSubject        String?
  slug                String
  heroImageUrl        String?
  tournamentName      String?
  tournamentLogoUrl   String?
  tournamentCategory  String?
  tournamentLocation  String?
  tournamentSurface   String?
  tournamentStartDate DateTime?
  tournamentEndDate   DateTime?
  worldRankSnapshot   Int?
  countryRankSnapshot Int?
  status              NewsletterStatus @default(DRAFT)
  publishedAt         DateTime?
  renderedHtml        String?
  brevoCampaignId     String?
  brevoSentAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  athlete   Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sections  NewsletterSection[]
  responses FanEngagementResponse[]

  @@unique([athleteId, slug])
  @@unique([athleteId, editionNumber])
  @@map("newsletter")
}

model FanEngagementResponse {
  id            String   @id @default(cuid())
  newsletterId  String
  blockId       String
  blockKind     String
  userId        String

  optionIndex   Int?
  isCorrect     Boolean?
  reaction      String?
  rating        Int?
  text          String?  @db.Text
  consentGiven  Boolean?

  payload       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  newsletter    Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, blockId, userId])
  @@index([newsletterId, blockId])
  @@index([userId])
  @@map("fan_engagement_response")
}

model NewsletterSection {
  id           String      @id @default(cuid())
  newsletterId String
  order        Int
  type         SectionType
  eyebrow      String?
  title        String?
  blocks       Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, order])
  @@index([newsletterId])
  @@map("newsletter_section")
}

model NewsletterSubscription {
  id                   String    @id @default(cuid())
  userId               String
  athleteId            String
  brevoContactId       String?
  partnerOffersConsent Boolean   @default(false)
  subscribedAt         DateTime  @default(now())
  unsubscribedAt       DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, athleteId])
  @@map("newsletter_subscription")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  position  Int?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waitlist")
}
