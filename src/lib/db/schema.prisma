
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  firstName     String?
  lastName      String?
  countryCode   String?
  phone         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions NewsletterSubscription[]

  @@unique([email])
  @@map("user")
}

enum Sport {
  TENNIS
}

enum UserRole {
  USER
  ADMIN
}

enum NewsletterStatus {
  DRAFT
  SENDING
  PUBLISHED
}

model Athlete {
  id           String   @id @default(cuid())
  slug         String   @unique
  firstName    String
  lastName     String
  sport        Sport    @default(TENNIS)
  tour         String?
  countryCode  String
  countryName  String
  bio          String?
  avatarUrl    String?
  worldRank    Int?
  countryRank  Int?
  titlesCount  Int      @default(0)
  brevoListId  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  newsletters   Newsletter[]
  subscriptions NewsletterSubscription[]

  @@map("athlete")
}

model Newsletter {
  id              String           @id @default(cuid())
  athleteId       String
  editionNumber   Int
  title           String
  slug            String
  heroImageUrl    String?
  status          NewsletterStatus @default(DRAFT)
  publishedAt     DateTime?
  renderedHtml    String?
  brevoCampaignId String?
  brevoSentAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  athlete        Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  debriefSection DebriefSection?

  @@unique([athleteId, slug])
  @@unique([athleteId, editionNumber])
  @@map("newsletter")
}

model DebriefSection {
  id                   String   @id @default(cuid())
  newsletterId         String   @unique
  body                 String
  pullQuote            String?
  pullQuoteContext     String?
  voiceNoteUrl         String?
  voiceNoteDurationSec Int?
  voiceNoteLabel       String?
  voiceNoteLocation    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@map("debrief_section")
}

model NewsletterSubscription {
  id                   String    @id @default(cuid())
  userId               String
  athleteId            String
  source               String?
  brevoContactId       String?
  partnerOffersConsent Boolean   @default(false)
  subscribedAt         DateTime  @default(now())
  unsubscribedAt       DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([userId, athleteId])
  @@map("newsletter_subscription")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  position  Int?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waitlist")
}
